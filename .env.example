# =====================================================================
# Smart Lost & Found - Application Environment Configuration
# =====================================================================

# Environment mode: 'local', 'development', or 'production'
# When set to 'production', error output is suppressed to prevent server path leakage
APP_NAME="Smart Lost & Found"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/lost_and_found

# =====================================================================
# Database Configuration
# =====================================================================
# For Docker Compose, set DB_HOST=db and DB_PORT=3306
# For local XAMPP, default DB_HOST=localhost and DB_PORT=3306
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_lostfound
DB_USER=root
DB_PASS=soorya25.

# Additional standard alias compatibility
DB_DATABASE=smart_lostfound
DB_USERNAME=root
DB_PASSWORD=soorya25.

# =====================================================================
# Cloud Database Hosting (Render / Railway / Heroku / TiDB / Aiven / JawsDB)
# =====================================================================
# If your cloud provider provisions a unified database URL, set it here:
# DATABASE_URL=mysql://username:password@hostname:3306/dbname
# JAWSDB_URL=mysql://username:password@hostname:3306/dbname
# CLEARDB_DATABASE_URL=mysql://username:password@hostname:3306/dbname
# MYSQL_URL=mysql://username:password@hostname:3306/dbname
# DB_SSL=true # Set to true for cloud hosts requiring SSL/TLS (TiDB, Aiven, PlanetScale)

# =====================================================================
# Production Settings (Example values for production container/host)
# =====================================================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://lostfound.kec.edu
# DB_HOST=db
# DB_PORT=3306
# DB_NAME=smart_lostfound
# DB_USER=lostfound_user
# DB_PASS=StrongProductionPassword2026!

